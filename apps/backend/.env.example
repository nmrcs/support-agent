DATABASE_URL="postgresql://support:support@localhost:5433/support_agent"
PORT=4001

# Any OpenAI-compatible provider. OpenRouter:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen3.5-9b
# Local LM Studio instead: uncomment the three lines below.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen/qwen3.5-9b

# The backend refuses to boot with the secret below unchanged.
# Generate: openssl rand -hex 32
AUTH_JWT_SECRET=dev-secret-change-me-please
AUTH_ACCESS_TTL=12h

# The origin the browser app is served from (CORS).
FRONTEND_ORIGIN=http://localhost:4000
